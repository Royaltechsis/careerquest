# Neon Postgres connection string (Neon dashboard → Connect → copy the pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Random secret used to sign session tokens. Generate one with:  openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# Optional: comma-separated emails that become admins (access to /admin) when they sign up or log in
ADMIN_EMAILS="you@example.com"
